# CEMICODE — variables de entorno (copia a .env, NUNCA commitees .env)
# DGX / GDX Spark (verificado 30-sep-2026)
DGX_HOST=192.168.4.4
DGX_LLM_PORT=8000
DGX_LLM_BASE=http://192.168.4.4:8000/v1
DGX_LLM_MODEL=Qwen3.6-35B-A3B
DGX_AUTH_BASE=http://192.168.4.4:8100
DGX_AUTH_SUB=cemicode
DGX_AUTH_ROL=TECNOLOGIA
# OJO: no pegues la clave real aqui en git. Exportala solo en tu sesion local:
#   setx DGX_CLAVE "tu-clave-real"
# o crea .env local (gitignored) con DGX_CLAVE=...
DGX_CLAVE=

# OpenCode Zen (opcional, para reviewer externo / fallback cloud)
# OPENCODE_ZEN_API_KEY=

# Proyecto
CEMICODE_PROJECT=CEMICODE
CEMICODE_TOKEN_CACHE=.cemicode/token.json
