{
  "$schema": "https://opencode.ai/config.json",
  "model": "gdx-spark/Qwen3.6-35B-A3B",
  "default_agent": "orchestrator",
  "provider": {
    "gdx-spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GDX Spark Qwen3.6-35B (local DGX)",
      "options": {
        "baseURL": "http://192.168.4.4:8000/v1",
        "apiKey": "no-hace-falta",
        "headers": {
          "X-CEMICODE-Project": "CEMICODE"
        }
      },
      "models": {
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6-35B-A3B (GDX Spark, 128K)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "agent": {
    "orchestrator": {
      "description": "Director CEMICODE: planifica y delega al pool GDX+Zen en la misma sesion. No edita directamente.",
      "mode": "primary",
      "model": "gdx-spark/Qwen3.6-35B-A3B",
      "prompt": "{file:.opencode/agents/orchestrator.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "color": "#2563EB"
    },
    "coder-dgx": {
      "description": "Especialista en codigo ejecutado en DGX GDX Spark. Implementa y edita.",
      "mode": "subagent",
      "model": "gdx-spark/Qwen3.6-35B-A3B",
      "prompt": "{file:.opencode/agents/coder-dgx.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "reasoning-dgx": "allow",
          "reviewer-zen": "allow"
        }
      },
      "color": "#0EA5E9"
    },
    "reasoning-dgx": {
      "description": "Arquitecto DGX: diseno, algoritmos complejos y debug dificil. Solo analiza.",
      "mode": "subagent",
      "model": "gdx-spark/Qwen3.6-35B-A3B",
      "prompt": "{file:.opencode/agents/reasoning-dgx.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "color": "#7C3AED"
    },
    "reviewer-zen": {
      "description": "Revisor QA: tests, auditoria y calidad pulida.",
      "mode": "subagent",
      "model": "gdx-spark/Qwen3.6-35B-A3B",
      "prompt": "{file:.opencode/agents/reviewer-zen.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      },
      "color": "#FB7185"
    },
    "flash-zen": {
      "description": "Lector flash Zen: lecturas rapidas y tareas cortas. Solo analiza.",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "prompt": "{file:.opencode/agents/flash-zen.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "color": "#FBBF24"
    },
    "ocr-zen": {
      "description": "OCR y visual Zen: imagenes, UI y frontend. Solo analiza.",
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free",
      "prompt": "{file:.opencode/agents/ocr-zen.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "color": "#38BDF8"
    },
    "apis-zen": {
      "description": "APIs y estado Zen: conexiones, endpoints y auditoria. Prueba sin editar.",
      "mode": "subagent",
      "model": "opencode/ling-3.0-flash-fin-free",
      "prompt": "{file:.opencode/agents/apis-zen.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      },
      "color": "#A78BFA"
    },
    "coder-zen": {
      "description": "Programador Zen con Muse Spark: implementa y edita.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "{file:.opencode/agents/coder-zen.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "color": "#34D399"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python probe_dgx.py": "allow",
      "python scripts/cemicode-auth.py*": "allow",
      "python scripts/cemicode-chat.py*": "allow"
    }
  },
  "share": "disabled",
  "username": "cemicode"
}
